{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER;Database=DevLink;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Google": {
    "ClientId": "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "SenderEmail": "",
    "Password": ""
  },
  "Jwt": {
    "Issuer": "DevLink.Api",
    "Audience": "DevLink.Clients",
    "SigningKeys": [
      {
        "Id": "local-1",
        "Key": "SET-WITH-DOTNET-USER-SECRETS",
        "Status": "Active"
      }
    ]
  },
  "Security": {
    "CodeHmacKey": "SET-WITH-DOTNET-USER-SECRETS",
    "MediaUrlKey": "SET-WITH-DOTNET-USER-SECRETS"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5200" ]
  },
  "Deployment": {
    "Topology": "SingleInstance"
  }
}